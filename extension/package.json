  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@vscode/test-electron": "^2.4.0",
    "mocha": "^10.0.0",
    "playwright-core": "^1.50.0",
    "typescript": "^5.0.0"
  }
}
