{
  "name": "hispark-ai-agent",
  "displayName": "HiSpark AI Agent",
  "description": "AI Agent for HiSpark Studio",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hispark-ai-agent.openChat",
        "title": "HiSpark AI: Open Chat"
      }
    ]
